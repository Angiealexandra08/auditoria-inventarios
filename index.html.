<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema Profesional de Auditoría de Inventarios</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="topbar">
    <div class="header-content">
      <h1>📊 Auditoría de Inventarios</h1>
      <p>Módulo de Control Físico, Cruce de Diferencias y Generación de Informes Técnicos</p>
    </div>
  </header>

  <main>
    <!-- Tarjeta informativa vinculada a la investigación -->
    <section class="card info-card">
      <h2>💡 Sobre este Sistema de Auditoría</h2>
      <p class="muted">
        Esta herramienta digital forma parte del desarrollo práctico de investigación sobre control interno y verificación de existencias. 
        Permite auditar bodegas mediante el registro de conteos físicos, detección automática de mermas o sobrantes (faltantes/sobrantes), 
        incorporación de evidencias multimedia y emisión de informes listos para auditoría.
      </p>
    </section>

    <!-- 1. Crear / seleccionar auditoría -->
    <section class="card" id="seccion-auditorias">
      <h2>1. Gestión de Auditorías</h2>
      <form id="form-auditoria" class="grid">
        <label>Nombre de la auditoría
          <input type="text" id="aud-nombre" placeholder="Ej: Inventario General de Cierre 2026" required>
        </label>
        <label>Bodega / Sucursal
          <input type="text" id="aud-bodega" placeholder="Ej: Bodega Central - Zona Norte" required>
        </label>
        <label>Fecha de ejecución
          <input type="date" id="aud-fecha" required>
        </label>
        <label>Auditor Responsable
          <input type="text" id="aud-responsable" placeholder="Tu nombre / Cargo" required>
        </label>
        <button type="submit" class="btn primary">Crear y Iniciar Auditoría</button>
      </form>

      <div class="row">
        <label class="grow">Seleccionar auditoría guardada
          <select id="lista-auditorias"></select>
        </label>
        <button type="button" class="btn danger" id="btn-eliminar-auditoria">Eliminar auditoría</button>
      </div>
      <div class="row">
        <button type="button" class="btn" id="btn-exportar">Exportar respaldo (JSON)</button>
        <label class="btn" for="archivo-importar">Importar respaldo</label>
        <input type="file" id="archivo-importar" accept="application/json" hidden>
      </div>
    </section>

    <!-- 2. Auditoría activa -->
    <section class="card" id="seccion-trabajo" hidden>
      <h2>2. Registro de Conteo y Hallazgos</h2>
      <p id="info-auditoria" class="muted"></p>

      <form id="form-producto" class="grid">
        <label>Código de Artículo
          <input type="text" id="prod-codigo" placeholder="Ej: CEM-001" required>
        </label>
        <label>Descripción del Producto
          <input type="text" id="prod-nombre" placeholder="Ej: Saco de cemento 42.5 kg" required>
        </label>
        <label>Cantidad en Sistema
          <input type="number" id="prod-sistema" min="0" step="1" required>
        </label>
        <label>Cantidad Contada (Física)
          <input type="number" id="prod-contado" min="0" step="1" required>
        </label>
        <label>Costo Unitario ($)
          <input type="number" id="prod-costo" min="0" step="0.01" value="0">
        </label>
        <button type="submit" class="btn primary">Agregar producto</button>
      </form>

      <div class="resumen" id="resumen"></div>

      <div class="tabla-wrap">
        <table id="tabla-productos">
          <thead>
            <tr>
              <th>Código</th>
              <th>Producto</th>
              <th>Sistema</th>
              <th>Contado</th>
              <th>Diferencia</th>
              <th>Valor dif. ($)</th>
              <th>Estado</th>
              <th>Observación</th>
              <th>Anexos</th>
              <th></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <p id="sin-productos" class="muted">Todavía no hay productos registrados en esta auditoría.</p>
    </section>

    <!-- 3. Informe -->
    <section class="card" id="seccion-informe" hidden>
      <div class="row">
        <h2 class="grow">3. Informe Final de Auditoría</h2>
        <button type="button" class="btn primary" id="btn-informe">Generar informe ejecutivo</button>
        <button type="button" class="btn" id="btn-imprimir" hidden>Imprimir / Guardar en PDF</button>
      </div>
      <div id="informe"></div>
    </section>
  </main>

  <footer class="muted">
    <p>Sistema de Auditoría de Inventarios — Desarrollado para investigación técnica y control operativo.</p>
    <p>Los datos se almacenan de forma segura en tu navegador (localStorage).</p>
  </footer>

  <script src="app.js"></script>
</body>
</html>
